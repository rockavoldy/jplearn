{
  "manifest_version": 3,
  "name": "JP Reader — Furigana & Dictionary",
  "version": "0.1.0",
  "description": "Extract Japanese articles with Readability and send them to your JP Reader backend for furigana and dictionary processing.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8080/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Scrape page to JP Reader"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "popup/options.html"
}

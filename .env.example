# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Comma-separated list of allowed CORS origins. A trailing "*" acts as a prefix
# match. Add your Cloudflare Pages domain here, e.g.
#   CORS_ALLOWED_ORIGINS=https://jp-reader.pages.dev,chrome-extension://*
CORS_ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*

# ---- Authentication ----
# Static API key required on write (POST/PUT/PATCH/DELETE) endpoints. The
# browser extension sends it as the X-API-Key header. Leave empty to disable
# auth entirely (local development only).
API_KEY=change-me-to-a-long-random-string

# ---- Feature flags ----
# EPUB upload is turned off for now. Set to true to re-enable the endpoint.
ENABLE_EPUB_UPLOAD=false

# ---- PostgreSQL ----
DATABASE_URL=postgres://jpl:jpl@localhost:5432/jplearn?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ---- Object Storage: Cloudflare R2 (S3-compatible) ----
# Create an R2 bucket and an API token (Access Key ID / Secret) in the
# Cloudflare dashboard. R2 uses region "auto" and virtual-hosted style.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=jp-scrapper
S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
S3_USE_PATH_STYLE=false
# Public bucket domain (r2.dev or a custom domain) used to build object URLs.
# Leave empty to serve images through the API proxy at /api/images/{id}.
S3_PUBLIC_BASE_URL=

# Local development alternative (MinIO from docker-compose):
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_USE_PATH_STYLE=true

# ---- Limits ----
MAX_EPUB_UPLOAD_BYTES=52428800
MAX_ARTICLE_PAYLOAD_BYTES=5242880

# ---- Dictionary (jmdict-simplified JSON from github.com/scriptin/jmdict-simplified) ----
# Accepts .json, .json.gz, .tgz or .zip release archives.
JMDICT_PATH=./data/jmdict-eng-3.5.0.json.tgz

# ---- Frontend (Vite) ----
# Baked into the SPA at build time. For Cloudflare Pages set this to your
# backend URL, e.g. https://api.example.com
VITE_API_BASE_URL=http://localhost:8080

# Show the EPUB upload UI/route in the SPA. Keep false while uploads are off.
VITE_ENABLE_EPUB_UPLOAD=false

# Only needed if the SPA performs authenticated writes (it is read-only today).
# VITE_API_KEY=

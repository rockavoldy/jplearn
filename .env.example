# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://*

# ---- PostgreSQL ----
DATABASE_URL=postgres://jpl:jpl@localhost:5432/jplearn?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ---- S3 / Object Storage (AWS S3, Cloudflare R2, MinIO all work) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jp-scrapper
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---- Limits ----
MAX_EPUB_UPLOAD_BYTES=52428800
MAX_ARTICLE_PAYLOAD_BYTES=5242880

# ---- Dictionary (jmdict-simplified JSON from github.com/scriptin/jmdict-simplified) ----
# Accepts .json, .json.gz, .tgz or .zip release archives.
JMDICT_PATH=./data/jmdict-eng-3.5.0.json.tgz

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8080
